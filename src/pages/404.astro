---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/site';
---

<BaseLayout title={`Page not found | ${profile.name}`}>
  <section class="mx-auto flex min-h-[60vh] max-w-5xl flex-col items-start justify-center px-6 py-24">
    <p class="mb-4 font-mono text-sm text-accent">404</p>
    <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-md leading-7 text-muted">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class="btn btn-primary mt-8">Back to the home page</a>
  </section>
</BaseLayout>
